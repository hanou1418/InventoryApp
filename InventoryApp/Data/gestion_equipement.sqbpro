-- PATCH v5 : Authentification
-- Login par défaut : admin / Mot de passe : admin123
-- (à changer immédiatement via l'interface après installation)
-- ============================================================

CREATE TABLE IF NOT EXISTS Utilisateur (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    login TEXT NOT NULL UNIQUE,
    mot_de_passe_hash TEXT NOT NULL,   -- SHA-256 hexadécimal (32 octets = 64 caractères)
    nom_affichage TEXT,
    actif INTEGER NOT NULL DEFAULT 1 CHECK(actif IN (0,1))
);

-- Admin par défaut : login=admin, mdp=admin123
-- Hash SHA-256 de &quot;admin123&quot;
INSERT OR IGNORE INTO Utilisateur (login, mot_de_passe_hash, nom_affichage, actif)
VALUES (
    'admin',
    '240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9',
    'Administrateur',
    1
);</sql><current_tab id="0"/></tab_sql></sqlb_project>
